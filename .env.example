# Usado pelo Docker Compose somente no ambiente local.
# Copie para .env e informe a chave pública da aplicação Mercado Pago.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-your-mercado-pago-public-key
MERCADOPAGO_ACCESS_TOKEN=TEST-your-mercado-pago-access-token
MERCADOPAGO_WEBHOOK_SECRET=your-mercado-pago-webhook-secret
MERCADOPAGO_ENVIRONMENT=sandbox
JWT_SECRET=dev-secret-key-not-for-production-min-256bits
SUBSCRIPTION_CALLBACK_SECRET=dev-callback-secret
