services:
  mysql:
    image: mysql:8.0.32
    restart: always
    ports:
      - "3306:3306"
    environment:
      MYSQL_ROOT_PASSWORD: root
      MYSQL_DATABASE: alexandriadb
    volumes:
      - mysql_data:/var/lib/mysql

volumes:
  mysql_data:
  
  backend:
    image: alexandria
    depends_on:
      - db
    environment:
      JWT_SECRET: dev-secret-key-not-for-production-min-256bits
      SPRING_DATASOURCE_URL: jdbc:mysql://db:3306/alexandria
      SPRING_DATASOURCE_USERNAME: root
      SPRING_DATASOURCE_PASSWORD:  root
